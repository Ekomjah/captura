AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET_NAME=

DB_USER=
DB_PASSWORD=
DB_NAME=

DATABASE_URL=

ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for dynamic origins, e.g. Vercel preview deploys.
# Glob https://captura-frontend-*-ekomjahs-projects.vercel.app/ becomes:
# ALLOWED_ORIGIN_REGEX=https://captura-frontend-.*-ekomjahs-projects\.vercel\.app
ALLOWED_ORIGIN_REGEX=
ENVIRONMENT=development

# Clerk
CLERK_WEBHOOK_SECRET=
# Instance JWKS URL, e.g. https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Comma-separated allowed Clerk `azp` origins. Falls back to ALLOWED_ORIGINS when empty.
CLERK_AUTHORIZED_PARTIES=
